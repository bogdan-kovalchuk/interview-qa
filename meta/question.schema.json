{
  "$defs": {
    "Language": {
      "enum": [
        "en",
        "uk"
      ],
      "title": "Language",
      "type": "string"
    },
    "ParsedBody": {
      "additionalProperties": false,
      "properties": {
        "preamble": {
          "title": "Preamble",
          "type": "string"
        },
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/ParsedSection"
          },
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "raw",
        "preamble",
        "sections"
      ],
      "title": "ParsedBody",
      "type": "object"
    },
    "ParsedSection": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "heading": {
          "title": "Heading",
          "type": "string"
        },
        "subsections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParsedSubsection"
          },
          "title": "Subsections",
          "type": "array"
        }
      },
      "required": [
        "heading",
        "content"
      ],
      "title": "ParsedSection",
      "type": "object"
    },
    "ParsedSubsection": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "heading": {
          "title": "Heading",
          "type": "string"
        }
      },
      "required": [
        "heading",
        "content"
      ],
      "title": "ParsedSubsection",
      "type": "object"
    },
    "QuestionFrontmatter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^(?:py|emb)-[a-z0-9]{3,8}-[0-9]{4}$",
          "title": "Id",
          "type": "string"
        },
        "section": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$",
          "title": "Section",
          "type": "string"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "track": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "track",
        "section"
      ],
      "title": "QuestionFrontmatter",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "title",
        "url"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "$id": "https://interview-qa.invalid/schema/question.schema.json",
  "additionalProperties": false,
  "properties": {
    "body": {
      "$ref": "#/$defs/ParsedBody"
    },
    "frontmatter": {
      "$ref": "#/$defs/QuestionFrontmatter"
    },
    "language": {
      "$ref": "#/$defs/Language"
    },
    "slug": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Slug",
      "type": "string"
    },
    "source_path": {
      "title": "Source Path",
      "type": "string"
    }
  },
  "required": [
    "language",
    "slug",
    "source_path",
    "frontmatter",
    "body"
  ],
  "title": "Interview QA question",
  "type": "object"
}
